<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:fd="http://www.adobe.com/aemfd/fd/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="cq:Page">
    <jcr:content jcr:primaryType="cq:PageContent">
        <guideContainer
                fd:version="2.1"
                jcr:primaryType="nt:unstructured"
                sling:resourceType="core/fd/components/print/container/v1/container">
            <fd:events
                    jcr:primaryType="nt:unstructured"
                />
            <fd:pageTemplate
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/fd/components/print/pagetemplate/v1/pagetemplate"
                    config="&lt;config xmlns=&quot;http://www.xfa.org/schema/xci/3.0/&quot;>&#xa;   &lt;agent name=&quot;designer&quot;>&#xa;      &lt;!--  [0..n]  -->&#xa;      &lt;destination>pdf&lt;/destination>&#xa;      &lt;pdf>&#xa;         &lt;!--  [0..n]  -->&#xa;         &lt;fontInfo>&lt;/fontInfo>&#xa;      &lt;/pdf>&#xa;   &lt;/agent>&#xa;   &lt;present>&#xa;      &lt;!--  [0..n]  -->&#xa;      &lt;pdf>&#xa;         &lt;!--  [0..n]  -->&#xa;         &lt;fontInfo>&#xa;            &lt;embed>0&lt;/embed>&#xa;         &lt;/fontInfo>&#xa;         &lt;tagged>0&lt;/tagged>&#xa;         &lt;version>1.7&lt;/version>&#xa;         &lt;adobeExtensionLevel>11&lt;/adobeExtensionLevel>&#xa;      &lt;/pdf>&#xa;      &lt;xdp>&#xa;         &lt;packets>*&lt;/packets>&#xa;      &lt;/xdp>&#xa;   &lt;/present>&#xa;&lt;/config>"
                    id="pagetemplate"
                    >
                <template
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/fd/components/print/template/v1/template"
                        fieldType="template"
                        id="template"
                        name="template">
                    <form1
                            fd:dorContainer="{Binary}\0"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/fd/components/form/panel/v1/panel"
                            fieldType="panel"
                            name="form1">
                        <fd:dorContainer
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="core/fd/components/print/paneldorcontainer/v1/paneldorcontainer"
                                layout="tb"
                                locale="en_US"
                                name="form1"
                                type="subform"/>
                        <Master_Pages
                                fd:dorContainer="{Binary}\0"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="core/fd/components/print/pageset/v1/pageset"
                                fieldType="pageset"
                                name="Master_Pages">
                            <fd:dorContainer
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="core/fd/components/print/pagesetdorcontainer/v1/pagesetdorcontainer"
                                    type="pageset"/>
                            <Page1
                                    fd:dorContainer="{Binary}\0"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="core/fd/components/print/pagearea/v1/pagearea"
                                    fieldType="pagearea"
                                    name="Page1">
                                <fd:dorContainer
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="core/fd/components/print/pageareadorcontainer/v1/pageareadorcontainer"
                                        id="Page1"
                                        name="Page1"
                                        type="pagearea"/>
                                <medium
                                        fd:dorContainer="{Binary}\0"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="core/fd/components/print/medium/v1/medium"
                                        fieldType="medium"
                                        name="medium">
                                    <fd:dorContainer
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="core/fd/components/print/mediumdorcontainer/v1/mediumdorcontainer"
                                            long="279.4mm"
                                            short="215.9mm"
                                            stock="default"
                                            type="medium"/>
                                </medium>
                                <contentarea
                                        fd:dorContainer="{Binary}\0"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="core/fd/components/print/contentarea/v1/contentarea"
                                        fieldType="contentarea"
                                        name="contentarea">
                                    <fd:dorContainer
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="core/fd/components/print/contentareadorcontainer/v1/contentareadorcontainer"
                                            height="266.7mm"
                                            left="6.35mm"
                                            top="6.35mm"
                                            type="contentarea"
                                            width="203.2mm"/>
                                </contentarea>
                            </Page1>
                        </Master_Pages>
                    </form1>
                </template>
            </fd:pageTemplate>
            <panel
                    fd:dorContainer="{Binary}\0"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/fd/components/form/panel/v1/panel"
                    fieldType="panel"
                    name="panel">
                <fd:dorContainer
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/fd/components/print/paneldorcontainer/v1/paneldorcontainer"
                        height="266.7mm"
                        type="subform"
                        width="203.2mm"/>
            </panel>
        </guideContainer>
    </jcr:content>
</jcr:root>